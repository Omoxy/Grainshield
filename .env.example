# GrainShield Platform Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# SECURITY: Never commit real credentials, tokens, or private keys to source control.

# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ==============================================================================
POSTGRES_DB=grainshield
POSTGRES_USER=grainshield
POSTGRES_PASSWORD=your_secure_postgres_password_min_16_chars
POSTGRES_PORT=5432

# Master database connection string (used by Next.js app and migration runner)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Per-service database passwords for least privilege isolation
GS_FARMER_DB_PASSWORD=change_this_to_a_secure_random_farmer_service_password
GS_POLICY_DB_PASSWORD=change_this_to_a_secure_random_policy_service_password
GS_PAYMENT_DB_PASSWORD=change_this_to_a_secure_random_payment_service_password
GS_PRICE_DB_PASSWORD=change_this_to_a_secure_random_price_service_password
GS_RISK_DB_PASSWORD=change_this_to_a_secure_random_risk_service_password
GS_WAREHOUSE_DB_PASSWORD=change_this_to_a_secure_random_warehouse_service_password
GS_NOTIFICATION_DB_PASSWORD=change_this_to_a_secure_random_notification_service_password

# ==============================================================================
# 2. CACHE & SESSION STORE (Redis 7)
# ==============================================================================
REDIS_PASSWORD=your_secure_redis_password_min_16_chars
REDIS_URL=redis://:your_secure_redis_password_min_16_chars@localhost:6379/0

# ==============================================================================
# 3. AUTHENTICATION & ENCRYPTION
# ==============================================================================
# JWT signing secret (HMAC-SHA256). Must be at least 32 cryptographically random bytes.
# Generate with: openssl rand -base64 48
JWT_SECRET=generate_with_openssl_rand_base64_48_min_32_chars_here

# Symmetric field-level encryption key (AES-256-GCM) for PII at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=generate_with_openssl_rand_base64_32_bytes_here

# Local developer authentication bypass (set to false in production)
ALLOW_DEV_AUTH=false
DEV_AUTH_PASSWORD=

# ==============================================================================
# 4. KAFKA EVENT BACKBONE
# ==============================================================================
KAFKA_BROKERS=localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_PREFIX=grainshield

# ==============================================================================
# 5. MICROSERVICE INTERNAL ENDPOINTS
# ==============================================================================
FARMER_SERVICE_URL=http://localhost:8080
POLICY_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082
PRICE_SERVICE_URL=http://localhost:8083
RISK_SERVICE_URL=http://localhost:8084
WAREHOUSE_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
USSD_SERVICE_URL=http://localhost:8087

# Service ports
PORT=8080
LOG_LEVEL=info

# ==============================================================================
# 6. EXTERNAL GATEWAYS & INTEGRATIONS (Sandbox defaults provided)
# ==============================================================================
# Africa's Talking (SMS & USSD)
AT_ENVIRONMENT=sandbox
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here
SMS_SENDER_ID=GRAINSHIELD

# Safaricom M-Pesa Daraja API
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_mpesa_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_daraja_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_lipa_na_mpesa_online_passkey_here
MPESA_CALLBACK_URL=https://api.grainshield.co.ke/api/v1/payments/mpesa/callback

# KEBS Input Verification API
KEBS_API_BASE_URL=https://api.kebs.org/v1
KEBS_API_KEY=your_kebs_api_key_here

# Object Storage (S3 / MinIO) for KYC uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=grainshield-kyc-documents
S3_ACCESS_KEY=your_s3_or_minio_access_key
S3_SECRET_KEY=your_s3_or_minio_secret_key
S3_REGION=af-south-1

# ==============================================================================
# 7. RUNTIME ENVIRONMENT
# ==============================================================================
NODE_ENV=development
